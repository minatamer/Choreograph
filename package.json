{
  "name": "choreograph",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24.19.0 <25" },
  "workspaces": ["apps/frontend"],
  "scripts": {
    "dev": "node scripts/local.mjs start",
    "stop": "node scripts/local.mjs stop",
    "status": "node scripts/local.mjs status",
    "db:up": "node scripts/local.mjs db-up",
    "db:stop": "node scripts/local.mjs db-stop",
    "typecheck": "npm run typecheck -w apps/frontend",
    "build": "npm run build -w apps/frontend",
    "test:lifecycle": "node --test scripts/local.test.mjs"
  },
  "devDependencies": { "@playwright/test": "1.64.1", "openapi-typescript": "7.13.0" }
}
