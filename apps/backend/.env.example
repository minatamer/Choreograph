# Backend/API/runner only. Run scripts/setup.py to prepare both app-local files.
# Fake AI makes no paid calls. HubSpot stays disabled until real OAuth is configured.
CHOREOGRAPH_PROFILE=fake
CHOREOGRAPH_DB_PASSWORD=LOCAL_PASSWORD
CHOREOGRAPH_DATABASE_URL=postgresql+psycopg://choreograph:LOCAL_PASSWORD@127.0.0.1:45862/choreograph
CHOREOGRAPH_ORIGIN=http://127.0.0.1:45860
CHOREOGRAPH_BRIDGE_SECRET=
CHOREOGRAPH_TOKEN_KEY=

# CRM is independent of the AI profile. Disabled makes zero CRM calls.
CHOREOGRAPH_CRM_PROVIDER=disabled
CHOREOGRAPH_AI_PAID_ENABLED=false
CHOREOGRAPH_CRM_ENABLED=false
# Leave models, prices, grant IDs and limits blank until separately reviewed.
CHOREOGRAPH_OPENAI_API_KEY=
CHOREOGRAPH_AI_RESPONSE_MODEL=
CHOREOGRAPH_AI_EMBEDDING_MODEL=
CHOREOGRAPH_AI_RESPONSE_TOKENIZER=
CHOREOGRAPH_AI_EMBEDDING_TOKENIZER=
CHOREOGRAPH_AI_EMBEDDING_DIMENSIONS=
CHOREOGRAPH_AI_CHUNKER=
CHOREOGRAPH_AI_GRANT_ID=
CHOREOGRAPH_AI_EXPIRES_AT=
CHOREOGRAPH_AI_REQUESTS=
CHOREOGRAPH_AI_INPUT_TOKENS=
CHOREOGRAPH_AI_OUTPUT_TOKENS=
CHOREOGRAPH_AI_VECTORS=
CHOREOGRAPH_AI_COST_MICROS=
CHOREOGRAPH_AI_WORKSPACE_REQUESTS=
CHOREOGRAPH_AI_WORKSPACE_INPUT_TOKENS=
CHOREOGRAPH_AI_WORKSPACE_OUTPUT_TOKENS=
CHOREOGRAPH_AI_WORKSPACE_VECTORS=
CHOREOGRAPH_AI_WORKSPACE_COST_MICROS=
CHOREOGRAPH_AI_RESPONSE_INPUT_RATE=
CHOREOGRAPH_AI_RESPONSE_OUTPUT_RATE=
CHOREOGRAPH_AI_EMBEDDING_INPUT_RATE=
CHOREOGRAPH_HUBSPOT_APP_ID=
CHOREOGRAPH_HUBSPOT_CLIENT_ID=
CHOREOGRAPH_HUBSPOT_CLIENT_SECRET=
CHOREOGRAPH_HUBSPOT_REDIRECT_URI=
CHOREOGRAPH_HUBSPOT_DISTRIBUTION=
CHOREOGRAPH_HUBSPOT_CAPACITY=
CHOREOGRAPH_CRM_GRANT_ID=
CHOREOGRAPH_CRM_EXPIRES_AT=
CHOREOGRAPH_CRM_REQUESTS=
CHOREOGRAPH_CRM_WORKSPACE_REQUESTS=
CHOREOGRAPH_HUBSPOT_SCHEMA_SETUP_ALLOWED=false
# Tasks are deployed only; the local runner delivers directly.
CHOREOGRAPH_TASKS_ENABLED=false
