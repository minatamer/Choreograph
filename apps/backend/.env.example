# API/runner: credentials, connection addresses and two mode controls only.
# Fixed settings and finite allowances: choreograph/runtime_config.py.
# Restart never renews an expired allowance.
FAKE_MODE=true
PAID_DEMO_ENABLED=false

OPENAI_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

CHOREOGRAPH_DB_PASSWORD=LOCAL_PASSWORD
CHOREOGRAPH_DATABASE_URL=postgresql+psycopg://choreograph:LOCAL_PASSWORD@127.0.0.1:45862/choreograph
CHOREOGRAPH_ORIGIN=http://127.0.0.1:45860
CHOREOGRAPH_BRIDGE_SECRET=
CHOREOGRAPH_TOKEN_KEY=

# Choreograph's OAuth app secret, configured once by its operator.
# Visitors use Connect; never paste a visitor CRM API token here.
# Public app/client IDs belong in runtime_config.py after app registration.
CHOREOGRAPH_HUBSPOT_CLIENT_SECRET=
